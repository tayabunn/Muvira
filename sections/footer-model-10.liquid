

<footer style="background:#111111;color:#ffffff;padding:60px 0 0 0;font-family:sans-serif;">
  <div class="container" style="max-width:1200px;margin:0 auto;padding:0 15px;">
    
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));gap:40px;padding-bottom:50px;border-bottom:1px solid #222222;">
      
      <!-- Brand Column with Logo -->
      <div>
        <a href="/" style="display:inline-block;margin-bottom:20px;">
          {% if section.settings.footer_logo != blank %}
            <img src="{{ section.settings.footer_logo | img_url: '210x84' }}" alt="Muvira Logo" style="max-height:50px;">
          {% else %}
            <img src="{{ 'logo.png' | asset_url }}" alt="Muvira Logo" style="max-height:45px;background:#ffffff;padding:6px 12px;border-radius:4px;">
          {% endif %}
        </a>
        <p style="color:#aaaaaa;font-size:14px;line-height:1.6;margin-bottom:20px;">Discover the finest collection of fashion, accessories, and lifestyle essentials at Muvira. Premium quality crafted for you.</p>
        
        <!-- Social Icons -->
        <div style="display:flex;gap:12px;">
          <a href="#" style="width:36px;height:36px;background:#222;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;text-decoration:none;transition:all 0.3s;" onmouseover="this.style.background='#e50914'" onmouseout="this.style.background='#222'"><i class="fa fa-facebook"></i></a>
          <a href="#" style="width:36px;height:36px;background:#222;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;text-decoration:none;transition:all 0.3s;" onmouseover="this.style.background='#e50914'" onmouseout="this.style.background='#222'"><i class="fa fa-instagram"></i></a>
          <a href="#" style="width:36px;height:36px;background:#222;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;text-decoration:none;transition:all 0.3s;" onmouseover="this.style.background='#e50914'" onmouseout="this.style.background='#222'"><i class="fa fa-twitter"></i></a>
          <a href="#" style="width:36px;height:36px;background:#222;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;text-decoration:none;transition:all 0.3s;" onmouseover="this.style.background='#e50914'" onmouseout="this.style.background='#222'"><i class="fa fa-pinterest"></i></a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 style="color:#ffffff;font-size:16px;font-weight:700;margin-bottom:20px;letter-spacing:1px;position:relative;padding-bottom:8px;">
          Quick Links
          <span style="position:absolute;bottom:0;left:0;width:35px;height:2px;background:#e50914;"></span>
        </h4>
        <ul style="list-style:none;padding:0;margin:0;line-height:2.2;font-size:14px;">
          <li><a href="/" style="color:#aaaaaa;text-decoration:none;transition:color 0.3s;" onmouseover="this.style.color='#e50914'" onmouseout="this.style.color='#aaaaaa'">Home</a></li>
          <li><a href="/collections/all" style="color:#aaaaaa;text-decoration:none;transition:color 0.3s;" onmouseover="this.style.color='#e50914'" onmouseout="this.style.color='#aaaaaa'">Catalog</a></li>
          <li><a href="/pages/contact" style="color:#aaaaaa;text-decoration:none;transition:color 0.3s;" onmouseover="this.style.color='#e50914'" onmouseout="this.style.color='#aaaaaa'">Contact Us</a></li>
          <li><a href="/pages/wishlist" style="color:#aaaaaa;text-decoration:none;transition:color 0.3s;" onmouseover="this.style.color='#e50914'" onmouseout="this.style.color='#aaaaaa'">Wishlist</a></li>
          <li><a href="/cart" style="color:#aaaaaa;text-decoration:none;transition:color 0.3s;" onmouseover="this.style.color='#e50914'" onmouseout="this.style.color='#aaaaaa'">My Cart</a></li>
        </ul>
      </div>

      <!-- Customer Service -->
      <div>
        <h4 style="color:#ffffff;font-size:16px;font-weight:700;margin-bottom:20px;letter-spacing:1px;position:relative;padding-bottom:8px;">
          Customer Care
          <span style="position:absolute;bottom:0;left:0;width:35px;height:2px;background:#e50914;"></span>
        </h4>
        <ul style="list-style:none;padding:0;margin:0;line-height:2.2;font-size:14px;">
          <li><a href="/account/login" style="color:#aaaaaa;text-decoration:none;transition:color 0.3s;" onmouseover="this.style.color='#e50914'" onmouseout="this.style.color='#aaaaaa'">Sign In</a></li>
          <li><a href="/account/register" style="color:#aaaaaa;text-decoration:none;transition:color 0.3s;" onmouseover="this.style.color='#e50914'" onmouseout="this.style.color='#aaaaaa'">Register Account</a></li>
          <li><a href="#" style="color:#aaaaaa;text-decoration:none;transition:color 0.3s;" onmouseover="this.style.color='#e50914'" onmouseout="this.style.color='#aaaaaa'">Shipping Policy</a></li>
          <li><a href="#" style="color:#aaaaaa;text-decoration:none;transition:color 0.3s;" onmouseover="this.style.color='#e50914'" onmouseout="this.style.color='#aaaaaa'">Returns & Refunds</a></li>
          <li><a href="#" style="color:#aaaaaa;text-decoration:none;transition:color 0.3s;" onmouseover="this.style.color='#e50914'" onmouseout="this.style.color='#aaaaaa'">Terms & Conditions</a></li>
        </ul>
      </div>

      <!-- Newsletter & Contact -->
      <div>
        <h4 style="color:#ffffff;font-size:16px;font-weight:700;margin-bottom:20px;letter-spacing:1px;position:relative;padding-bottom:8px;">
          Newsletter
          <span style="position:absolute;bottom:0;left:0;width:35px;height:2px;background:#e50914;"></span>
        </h4>
        <p style="color:#aaaaaa;font-size:14px;margin-bottom:15px;">Subscribe to receive updates, access to exclusive deals, and more.</p>
        
        <form method="post" action="/contact#contact_form" style="display:flex;gap:0;">
          <input type="email" name="contact[email]" placeholder="Enter your email" required style="padding:10px 14px;background:#222;border:1px solid #333;color:#fff;font-size:13px;outline:none;border-radius:4px 0 0 4px;flex:1;">
          <button type="submit" style="background:#e50914;color:#fff;border:none;padding:10px 18px;font-size:14px;font-weight:700;border-radius:0 4px 4px 0;cursor:pointer;">Join</button>
        </form>
      </div>

    </div>

    <!-- Bottom Copyright Bar -->
    <div style="padding:20px 0;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;color:#888888;font-size:13px;gap:15px;">
      <p style="margin:0;">Copyright &copy; {{ 'now' | date: "%Y" }} Muvira. Powered by Shopify.</p>
      
      <div style="display:flex;align-items:center;gap:15px;">
        <span style="font-size:12px;color:#666;">Secured Payments</span>
        <div style="display:flex;gap:8px;color:#aaa;font-size:20px;">
          <i class="fa fa-cc-visa"></i>
          <i class="fa fa-cc-mastercard"></i>
          <i class="fa fa-cc-paypal"></i>
          <i class="fa fa-cc-stripe"></i>
        </div>
      </div>
    </div>

  </div>
</footer>
  </div>

  <style>
    .footer-model-10 .site-footer__links a:hover,.footer-model-10 .office-mail a:hover {   color:{{ section.settings.footer_link_hover_clr }} !important;}
    .footer-model-10 .menu li a:hover { color:{{ section.settings.footer_menu_hover_clr }} !important;}
    .footer-model-10 .copyright a { color:{{ section.settings.copyright_link }};}
    .footer-model-10 .copyright a:hover { color:{{ section.settings.copyright_link_hover }};}
    .footer-model-10 .site-footer .grid-uniform .grid__item.footer__about a:hover { color:{{ section.settings.abt_link_hover_clr }} !important;}    
    .footer-model-10 .payment-icons a { color:{{ section.settings.payment_color }}; }
    .footer-model-10 .payment-icons a:hover { color:{{ section.settings.payment_hover_color }}; }
  </style>


