{% if section.settings.show_best_products %}
<div data-section-id="{{ section.id }}"  data-section-type="home-sidebar-featured" class="home-sidebar-featured">  
    <div class="widget widget_top_rated_products"  style ="background:{{section.settings.sidebar_bg_color}}">
      {% if collections[section.settings.feauted_items].products.size > 0 %} 
      {% if section.settings.title != blank %}
      <h4><span>{{ section.settings.title }}</span></h4>  
      {% endif %}
      {% endif %}
      <ul class="no-bullets sidebar-featured-products owl-carousel owl-theme">
       {% for product in collections[section.settings.feauted_items].products limit: section.settings.limit %}
        <li> 
          
          {% if product.images.size > 0 %}  
          <a class="thumb grid__item" href="{{ product.url | within: collection }}">                                          
            <img alt="featured product" src="{{ product.featured_image | product_img_url: 'master' }}">                                              
          
          {% if settings.count_down_enable and settings.count_down_collections %}
            {% assign dealTime = settings.home_productdeal_time | split: ' ' | join: ' ' | split: ' ' %}
            {% include 'deal-snippet-sidebar' %}
            {% endif %}
            </a>
          {% endif %} 
          <div class="products">
          <div class="top-products-detail product-detail grid__item"> 
                  <div class="product_left">
            <a class="grid-link__title" href="{{ product.url | within: collection }}"> {{ product.title }} </a>
           {% if settings.product_review %}  <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span> {% endif %}
                    {% include 'item-swatch' %}
            </div>
            <div class="top-product-prices grid-link__meta">
              
              <div class="product_price">
                <div class="grid-link__org_price">
                {{ product.price_min | money }}
                  </div>
              {% if product.compare_at_price_max > product.price %}
              <del>{{ product.compare_at_price_max | money }}</del>
              {% endif %}
                 </div>
            </div>
            {% if product.compare_at_price > product.price %}
            <span class="sale">{{ 'products.product.sale' | t }}</span>    
            {% endif %}
            </div>
          </div>
        </li>
        
        {% else %}
         {% for i in (1..section.settings.limit) %}
         {%- assign featured_products = "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1584917865442-de89df76afd3?w=600&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80" | split: "," -%}
         {%- assign feat_idx = i | minus: 1 | modulo: 4 -%}
         {%- assign feat_img = featured_products[feat_idx] -%}
         {%- assign feat_titles = "Minimalist Watch,Running Sneakers,Leather Tote Bag,Wireless Headphones" | split: "," -%}
         {%- assign feat_title = feat_titles[feat_idx] -%}

        <li>
          <div class="products   wow fadeIn   animated" style="visibility: visible;">
            <div class="product-container">
              <a href="#" class="grid-link"> 
                {% if forloop.index == 3 %}
                <span class="badge badge--sale"> <span class="gift-tag badge__text">Sale</span> </span>
                {% endif %}

                <div class="reveal" style="aspect-ratio: 1 / 1; width: 100%; overflow: hidden;"> 
                  <img src="{{ feat_img }}" alt="{{ feat_title }}" style="width:100%;height:100%;aspect-ratio:1/1;object-fit:cover;" />
                </div>
              </a>
              <div class="ImageWrapper">
                <div class="product-button">
                  <a href="#" id="party-wear-heel" class="quick-view-text"> 
                  <i class="fa fa-expand" aria-hidden="true"></i> 
                  </a>
                  <form action="#" method="post" class="variants clearfix" id="cart-form-6529189125">
                <input type="hidden" name="id" value="21661289093">
                <a href="#" class="add-cart-btn"><i class="fa fa-shopping-cart"></i> </a>
              </form>
                  <a href="/account/login" class="wishlist"><i class="fa fa-heart"></i></a> </div>
              </div>
            </div>
            <div class="product-detail"> 
              <a href="#" class="grid-link__title">{{ feat_title }}</a>
              <div class="grid-link__meta">
                <div class="product_price"> <span class="money">${{ i | times: 20 | plus: 39 }}.00</span> </div>
                <del class="grid-link__sale_price"><span class="money">${{ i | times: 20 | plus: 69 }}.00</span></del> </div>
              
            </div>
          </div>
        </li>
        {% endfor %} 
         {% endfor %}
      </ul> 
     <div class="home_sidebar--featured-nav"></div>
      
    </div>
  <style>
    .home-sidebar-featured .lof-clock-timer-detail-single li {background:{{ section.settings.dealbtn }};border:1px solid {{ section.settings.dealbtn_border }};color:{{ section.settings.dealbtn_text }};}

  </style>
</div>
 {% endif %} 

 {% schema %}
  {
    "name": "Home Sidebar Featured",    
    "settings": [	
      {
        "type": "checkbox",
        "id": "show_best_products",
        "label": "Enable best featured"
      },
{
"type": "color",
"id": "sidebar_bg_color",
"label": "Bg Color",
"default": "#fff"
},
	 {
        "type": "text",
        "id": "title",
        "label": "Heading"
      },
      {
        "type": "collection",
        "id": "feauted_items",
        "label": "Collection"
      },
{
        "type": "color",
        "id": "dealbtn_border",
        "label": "Deal Button Border",
        "default": "#000"
      },
{
        "type": "color",
        "id": "dealbtn",
        "label": "Deal Button Bg",
        "default": "#000"
      },
      {
        "type": "color",
        "id": "dealbtn_text",
        "label": "Deal Button Text",
        "default": "#000"
      },

      {
        "type": "text",
        "id": "limit",
        "label": "Product Limit",
        "default": "4"
      }
	
]
  }
{% endschema %}

{% javascript %}
 $(document).ready(function(){
     var homeSidefeatured = $(".sidebar-featured-products");
      homeSidefeatured.owlCarousel({
      items:1,
         loop:true,              
         dots: false,
         navContainer: ".home_sidebar--featured-nav",
         navText: [' <a class="prev active btn"><i class="icon-arrow-left icons"></i></a>','<a class="next btn"><i class="icon-arrow-right icons"></i></a>'],
         responsive:{
           0:{
             items: 1
           },
           600:{
             items:1
           },
           700:{
             items:1
           },
           
           1000:{
             items: 1
           }
         }
  			});
        });
{% endjavascript %}
