<div data-section-id="{{ section.id }}"  data-section-type="vertical-product-grid-type-1" class="vertical-product-grid-type-1" >
 {%- assign collection = collections[section.settings.collection] -%}
 {%- assign limit = section.settings.grid | times: section.settings.rows -%}  
  {%- assign tp = section.settings.total_products  -%}
  
  <div class="vertical-product-grid" style="float:left;width:100%;background-color:{{ section.settings.vertical_bg }};">
    <div class="dt-sc-hr-invisible-small"></div>
    <div class="container-bg">
      {% if section.settings.title != blank or section.settings.small_title  %}
      <div class="section-header section-header--small">
        <div class="border-title">
          {% endif %}            
          {% if section.settings.title != blank %}
          <h2 class="section-header__title" style="color:{{ section.settings.title_color }};">    
            {{ section.settings.title }}
          </h2>
          {% endif %}  
          {% if section.settings.small_title != blank %}<div class="short-desc"> <p style="color:{{ section.settings.small_title_color }};">{{ section.settings.small_title }}</p></div>{% endif %}  
          {% if section.settings.title != blank or section.settings.small_title  %}
        </div>
      </div>    
    <div class="dt-sc-hr-invisible-small"></div>
      {% endif %}      
  		 {% case section.settings.grid %}
            {% when '2' %}
            {%- assign grid_item_width = 'wide--one-half post-large--one-half large--one-half medium--one-half small-grid__item' -%}
            {% when '3' %}
            {%- assign grid_item_width = 'wide--one-third post-large--one-third large--one-half medium--one-half small-grid__item' -%}
            {% when '4' %}
            {%- assign grid_item_width = 'wide--one-quarter post-large--one-third large--one-half medium--one-half small-grid__item' -%}
            {% when '5' %}
            {%- assign grid_item_width = 'wide--one-fifth post-large--one-quarter large--one-half medium--one-half small-grid__item' -%}            
            {% endcase %}
   
      <div class="grid-uniform">    
  
      <ul class="v_grid-type-1__items">
        {% for product in collection.products limit:limit   %}
        {% include 'v_grid_item_garden', grid_item_width:grid_item_width %}          
        {% endfor %}
      </ul>
       <div class="nav_v_grid-type-1__items">
            <a class="prev active"></a>
            <a class="next"></a>  
          </div>
    </div>
    </div>
    <style>
  
  .vertical-product-grid-type-1 ul li .products { background:{{ section.settings.detail_bg }}; }
  
</style>
    </div>
  <div class="dt-sc-hr-invisible-small"></div>
  
</div>
  
  
{% schema %}
{
  "name": "Vertical Product Grid 1",
  "class": "index-section",
  "settings": [  
	{
      "type": "color",
      "id": "vertical_bg",
      "label": "Bg Color",
	  "default": "#fff"
    },	
		{
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New arrivals"
    },	
	{
      "type": "color",
      "id": "title_color",
      "label": "Heading Color",
	  "default": "#000"
    },	
	{
      "type": "text",
      "id": "small_title",
      "label": "Small Heading"
    },	
	{
      "type": "color",
      "id": "small_title_color",
      "label": "Small Heading Color",
	  "default": "#000"      
    },	
    {
      "id": "collection",
      "type": "collection",
      "label": "Collection"
    },
{
      "type": "color",
      "id": "detail_bg",
      "label": "Product Detail Bg",
      "default":"#000"	
      },
    {
      "type": "select",
      "id": "grid",
      "label": "Products per row",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
       
      ]
    },
{
        "type": "select",
        "id": "rows",
        "label": "Rows per page (grid only)",
        "default": "2",
        "options": [
			{
            "value": "1",
            "label": "1"
          },
          {
            "value": "2",
            "label": "2"
          },
          {
            "value": "3",
            "label": "3"
          },
          {
            "value": "4",
            "label": "4"
          },
          {
            "value": "5",
            "label": "5"
          }          
        ]
      }
  
  ],
  "presets": [
    {
       "name": "Vertical Product Grid 1",
      "category": "Collection"
    }
  ]
}
{% endschema %}



