<div data-section-id="{{ section.id }}" data-section-type="grid-banner-type-14" class="grid-banner-type-14">   
  <div class="grid-uniform">  
     
     <div class="grid__item wide--one-half post-large--one-half large--one-half medium-down--one-half small--grid__item img-hover-effect-3 img-hover-effect wow fadeInLeft">
      {% if section.settings.link_1 != blank %}<a class="banner_half_img" href="{{ section.settings.link_1 }}">{% endif%}
      {% if section.settings.image_1 != blank %}
      <img src="{{ section.settings.image_1 | img_url: 'master' }}" alt="{{ section.settings.title_1 }}" />
      {% else %}
      <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?w=800&q=80" alt="New Season Collection" style="width:100%;max-height:235px;object-fit:cover;" />
      {% endif%}           
      {% if section.settings.link_1 != blank %}  </a>
      {% endif%}
      <div class="featured-content">       
        {% if section.settings.title_1 != blank %}
        <h2 style="color:{{ section.settings.title_1_color }}">{{ section.settings.title_1 }}</h2>
        {% else %}
        <h2>New Season</h2>
        {% endif %}
        {% if section.settings.text_1 != blank %}
        <p style="color:{{ section.settings.text_1_color }}">{{ section.settings.text_1}}</p>    
        {% endif %}  
        {% if section.settings.button_1 != blank %}
        <a class="btn three" href="{{ section.settings.link_1 }}" style="color:{{ section.settings.button_1_txt_color }};border:none;background-color:{{ section.settings.button_1_bg_color }};">{{ section.settings.button_1}}</a>    
        {% endif %}         
      </div>   
    </div> 
     <div class="grid__item wide--one-half post-large--one-half large--one-half medium-down--one-half small--grid__item img-hover-effect img-hover-effect-4 wow fadeInUp">
      {% if section.settings.link_2 != blank %}<a class="banner_half_img" href="{{ section.settings.link_2 }}">{% endif%}
      {% if section.settings.image_2 != blank %}
      <img src="{{ section.settings.image_2 | img_url: 'master' }}" alt="{{ section.settings.title_2 }}" />
      {% else %}
      <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=800&q=80" alt="Exclusive Summer Style" style="width:100%;max-height:235px;object-fit:cover;" />
      {% endif%}           
      {% if section.settings.link_2 != blank %}  </a>
      {% endif%}
      <div class="featured-content">     
        {% if section.settings.offer != blank or section.settings.offer_text != blank  %}
        <div class="offer_text">{{ section.settings.offer }}<p><span>{{ section.settings.offer_text }}</span></p></div>
        {% endif %} 
        {% if section.settings.title_2 != blank %}
        <h2 style="color:{{ section.settings.title_2_color }}">{{ section.settings.title_2 }}</h2>
        {% endif %}
        {% if section.settings.text_2 != blank %}
        <p style="color:{{ section.settings.text_2_color }}">{{ section.settings.text_2}}</p>    
        {% endif %}  
        
        {% if section.settings.button_2 != blank %}
        <a class="btn four" href="{{ section.settings.link_2 }}" style="color:{{ section.settings.button_2_txt_color }};border:none;background-color:{{ section.settings.button_2_bg_color }};">{{ section.settings.button_2}}</a>    
        {% endif %}         
       </div>
      </div>     
  </div>    
  <div class="dt-sc-hr-invisible-small"></div>
  </div>
<style>
   .grid-banner-type-14 .featured-content .btn.one:hover { background:{{ section.settings.button_4_hover_bg_color }} !important;color:{{ section.settings.button_4_hover_txt_color }} !important;}
  .grid-banner-type-14 .featured-content .btn.two:hover { background:{{ section.settings.button_3_hover_bg_color }} !important; color:{{ section.settings.button_3_hover_txt_color }} !important;}
   .grid-banner-type-14 .featured-content .btn.three:hover { background:{{ section.settings.button_1_hover_bg_color }} !important;color:{{ section.settings.button_1_hover_txt_color }} !important; }
   .grid-banner-type-14 .featured-content .btn.four:hover { background:{{ section.settings.button_2_hover_bg_color }} !important;color:{{ section.settings.button_2_hover_txt_color }} !important; }
    .grid-banner-type-14 .featured-content .offer_text { color:{{ section.settings.offer_text_clr }}; }
  .grid-banner-type-14 .featured-content p span:before,.grid-banner-type-14 .featured-content p span:after { background:{{ section.settings.offer_text_clr }}; }
  
</style>
      

