{% if section.blocks.size > 0 %}  
<div data-section-id="{{ section.id }}"  data-section-type="home-sidebar-promoimage" class="home-sidebar-promoimage">  
<div class="widget widget_promo_img" style ="background:{{section.settings.sidebar_bg_color}}">
  <ul id="promo-carousel" class="owl-carousel owl-theme">
    {% for block in section.blocks %}
   
    <li>
      <a href="{{ block.settings.promo_link }}" title="{{ block.settings.promo_title }}"> 
         {% if block.settings.promo_img != blank %}
        <img src="{{ block.settings.promo_img | img_url : '750x750' }}" alt="{{ block.settings.promo_title }}" title="{{ block.settings.promo_title }}" /> 
              
           {% else %}
             {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
               {%- assign placeholder_image = 'collection-' | append: placeholder_image_index -%}
              {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
           
           {% endif %}
      </a>
           
    </li>
    
    {% endfor %}
  </ul>
</div>
</div>
{% endif %}
{% schema %}
{
"name": "Home Sidebar Banner",
"max_blocks": 3,
"settings": [
{
"type": "color",
"id": "sidebar_bg_color",
"label": "Bg Color",
"default": "#fff"
}


],
"blocks": [
{
"type": "content",
"name": "Promo  banner",
"settings": [	
{
"type": "image_picker",
"id": "promo_img",
"label": "Image",
"info": "Size: 430x500"
},
{
"type": "url",
"id": "promo_link",
"label": "URL"
}
]
}
]
}
{% endschema %}

{% stylesheet %}
#instafeed a {width: 33%;}
{% endstylesheet %}


{% javascript %}
 $(document).ready(function(){
     var promoimage = $("#promo-carousel");
      promoimage.owlCarousel({
         items:1,
         loop:true,              
         dots: true,       
         responsive:{
           0:{
             items: 1
           },
           600:{
             items:1
           },
           700:{
             items: 1
           },           
           1000:{
             items: 1
           }
         }
  			});
        });
{% endjavascript %}

