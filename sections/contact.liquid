
{% comment %}
Regular page content goes here.
{% endcomment %}
<div class="rte">
  {{ page.content }}
</div>


<div class="contact-page-advanced" style="background:#ffffff;padding:40px 0 60px 0;">
  <div class="container" style="max-width:1200px;margin:0 auto;padding:0 15px;">
    
    <!-- Hero Banner Header -->
    <div style="text-align:center;margin-bottom:50px;">
      <span style="color:#e50914;font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;">We'd Love To Hear From You</span>
      <h1 style="font-size:36px;font-weight:800;color:#000000;margin:10px 0 15px 0;">Get In Touch With Muvira</h1>
      <p style="color:#666666;font-size:16px;max-width:600px;margin:0 auto;line-height:1.6;">Have a question about our products, orders, or custom requests? Drop us a message or visit our store!</p>
      <div style="width:60px;height:4px;background:#e50914;margin:20px auto 0 auto;border-radius:2px;"></div>
    </div>

    <!-- Contact Info Cards Grid -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:25px;margin-bottom:50px;">
      
      <!-- Address Card -->
      <div style="background:#ffffff;border-radius:12px;padding:35px 25px;box-shadow:0 8px 25px rgba(0,0,0,0.05);border-top:4px solid #e50914;text-align:center;transition:transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="width:60px;height:60px;background:#ffebee;color:#e50914;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 20px auto;">
          <i class="fa fa-map-marker"></i>
        </div>
        <h3 style="font-size:18px;font-weight:700;color:#000000;margin-bottom:10px;">Our Store Location</h3>
        <p style="color:#555555;font-size:14px;line-height:1.6;margin:0;">123 Fashion Street, Avenue Tower<br>Suite 405, Dhaka, Bangladesh</p>
      </div>

      <!-- Phone Card -->
      <div style="background:#ffffff;border-radius:12px;padding:35px 25px;box-shadow:0 8px 25px rgba(0,0,0,0.05);border-top:4px solid #000000;text-align:center;transition:transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="width:60px;height:60px;background:#f0f0f0;color:#000000;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 20px auto;">
          <i class="fa fa-phone"></i>
        </div>
        <h3 style="font-size:18px;font-weight:700;color:#000000;margin-bottom:10px;">Phone & WhatsApp</h3>
        <p style="color:#555555;font-size:14px;line-height:1.6;margin:0;">+880 (17) 0000-1122<br>Mon - Sat: 9:00 AM - 9:00 PM</p>
      </div>

      <!-- Email Card -->
      <div style="background:#ffffff;border-radius:12px;padding:35px 25px;box-shadow:0 8px 25px rgba(0,0,0,0.05);border-top:4px solid #e50914;text-align:center;transition:transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
        <div style="width:60px;height:60px;background:#ffebee;color:#e50914;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 20px auto;">
          <i class="fa fa-envelope"></i>
        </div>
        <h3 style="font-size:18px;font-weight:700;color:#000000;margin-bottom:10px;">Email & Support</h3>
        <p style="color:#555555;font-size:14px;line-height:1.6;margin:0;">support@muvira.com<br>info@muvira.com</p>
      </div>

    </div>

    <!-- Contact Form & Map Section -->
    <div style="display:flex;flex-wrap:wrap;gap:30px;background:#ffffff;border-radius:16px;padding:40px;box-shadow:0 10px 35px rgba(0,0,0,0.06);">
      
      <!-- Contact Form -->
      <div style="flex:1 1 500px;min-width:300px;">
        <h2 style="font-size:24px;font-weight:700;color:#000000;margin-bottom:10px;">Send Us A Message</h2>
        <p style="color:#666666;font-size:14px;margin-bottom:25px;">Fill out the form below and our team will get back to you within 24 hours.</p>

        {% form 'contact' %}
          {% if form.posted_successfully? %}
          <div style="background:#e6fffa;color:#234e52;padding:15px;border-radius:8px;margin-bottom:20px;font-weight:600;">
            <i class="fa fa-check-circle"></i> Thank you! Your message has been sent successfully.
          </div>
          {% endif %}
          {{ form.errors | default_errors }}

          <div style="display:flex;gap:15px;margin-bottom:15px;flex-wrap:wrap;">
            <div style="flex:1;min-width:200px;">
              <label style="font-size:13px;font-weight:600;color:#333;display:block;margin-bottom:5px;">Your Name *</label>
              <input type="text" id="ContactFormName" name="contact[name]" placeholder="John Doe" required style="width:100%;padding:12px 15px;border:1px solid #ddd;border-radius:6px;font-size:14px;outline:none;">
            </div>
            <div style="flex:1;min-width:200px;">
              <label style="font-size:13px;font-weight:600;color:#333;display:block;margin-bottom:5px;">Email Address *</label>
              <input type="email" id="ContactFormEmail" name="contact[email]" placeholder="john@example.com" required style="width:100%;padding:12px 15px;border:1px solid #ddd;border-radius:6px;font-size:14px;outline:none;">
            </div>
          </div>

          <div style="margin-bottom:15px;">
            <label style="font-size:13px;font-weight:600;color:#333;display:block;margin-bottom:5px;">Phone Number</label>
            <input type="tel" id="ContactFormPhone" name="contact[phone]" placeholder="+880 1700001122" style="width:100%;padding:12px 15px;border:1px solid #ddd;border-radius:6px;font-size:14px;outline:none;">
          </div>

          <div style="margin-bottom:20px;">
            <label style="font-size:13px;font-weight:600;color:#333;display:block;margin-bottom:5px;">Your Message *</label>
            <textarea rows="5" id="ContactFormMessage" name="contact[body]" placeholder="How can we help you?" required style="width:100%;padding:12px 15px;border:1px solid #ddd;border-radius:6px;font-size:14px;outline:none;resize:vertical;"></textarea>
          </div>

          <button type="submit" style="background:#e50914;color:#ffffff;border:none;padding:14px 35px;font-size:15px;font-weight:700;border-radius:6px;cursor:pointer;transition:background 0.3s;display:inline-flex;align-items:center;gap:8px;">
            <i class="fa fa-paper-plane"></i> Send Message
          </button>
        {% endform %}
      </div>

      <!-- Map & Details Column -->
      <div style="flex:1 1 400px;min-width:300px;display:flex;flex-direction:column;">
        <h2 style="font-size:24px;font-weight:700;color:#000000;margin-bottom:10px;">Visit Our Showroom</h2>
        <p style="color:#666666;font-size:14px;margin-bottom:20px;">Experience Muvira collection live in store.</p>
        
        <div style="flex:1;min-height:300px;border-radius:12px;overflow:hidden;border:1px solid #e0e0e0;">
          {% if section.settings.contact_iframe_code != blank %}
            {{ section.settings.contact_iframe_code }}
          {% else %}
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3651.902442430138!2d90.3910801!3d23.7508581!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjPCsDQ1JzAzLjEiTiA5MMKwMjMnMz2LjkiRQ!5e0!3m2!1sen!2sbd!4v1600000000000!5m2!1sen!2sbd" width="100%" height="100%" style="border:0;min-height:300px;" allowfullscreen="" loading="lazy"></iframe>
          {% endif %}
        </div>
      </div>

    </div>

  </div>
</div>





<style>



  .contact-page-four .contact-form input, .contact-page-four .contact-form textarea{background:{{section.settings.input_bgcolor}};}

  .detail-section .icon-section  h4{color:{{section.settings.detail_titlecolor}};}

  .contact-page-four .icon-section p{color:{{section.settings.contact_4_paragraphcolor}};}

  .contact-page-four .contct-form-section {background: {{section.settings.contact_4_formbgcolor}}; }

  .contact-page .icon-section { border: 1px solid  {{section.settings.detail_bordercolor}};}

  .contact-page-four a{color:{{section.settings.contact_4_linkcolor}};   transition: all 0.3s linear 0s;}

  .contact-page-four a:hover{color:{{section.settings.contact_4_linkhovercolor}};}

  .contact-page-four .contact-btn{background:{{section.settings.contact_4_btnbg}};color:{{section.settings.contact_4_btncolor}};}

  .contact-page-four .contact-btn:hover{color:{{section.settings.contact_4_btnhovercolor}};}

  .contact-page-four .contact-btn:hover{background:{{section.settings.contact_4_btnhoverbg}};}

  .contact-page-four .icon {color:{{section.settings.contact_4_iconcolor}};}

  .contact-page-four .icon-text{color:{{section.settings.contact_4_icontextcolor}};}

  .contact-page-four .contact-icon:hover .icon{background:{{section.settings.contact_4_iconhoverbg}};}

  .contact-page .contact-large { color: {{section.settings.large_icon_color}};}









</style>













