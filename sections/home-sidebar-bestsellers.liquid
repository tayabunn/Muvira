{% if section.settings.show_best_products %}
<div data-section-id="{{ section.id }}"  data-section-type="home-sidebar-bestsellers" class="home-sidebar-bestsellers">  
    <div class="widget widget_top_rated_products" style ="background:{{section.settings.sidebar_bg_color}}">
      {% if collections[section.settings.bestseller].products.size > 0 %} 
      {% if section.settings.title != blank %}
      <h4><span>{{ section.settings.title }}</span></h4>  
      {% endif %}
      {% endif %}      
      <ul class="no-bullets top-products">
       {% for product in collections[section.settings.bestseller].products limit: section.settings.limit %}
        <li class="products"> 
          <div class="top-products-detail product-detail">            
            <a class="grid-link__title" href="{{ product.url | within: collection }}"> {{ product.title }} </a>            
            <div class="top-product-prices grid-link__meta">
              
              <div class="product_price">
                <div class="grid-link__org_price">
                {{ product.price_min | money }}
                  </div>
              {% if product.compare_at_price_max > product.price %}
              <del>{{ product.compare_at_price_max | money }}</del>
              {% endif %}
                 </div>
            </div>
                
           {% if settings.product_review %}  <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span> {% endif %}
   
          </div>
            {% comment %}
            {% if product.compare_at_price > product.price %}
            <span class="sale">{{ 'products.product.sale' | t }}</span>    
            {% endif %}
            {% endcomment %}
           
          
          {% if product.images.size > 0 %}            
          <a class="thumb" href="{{ product.url | within: collection }}">                  
            <img alt="featured product" src="{{ product.featured_image | product_img_url: 'small' }}">                                              
          </a>
          {% endif %} 
        </li>
        
        {% else %}
         {% for i in (1..section.settings.limit) %}
         {%- assign sidebar_products = "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1584917865442-de89df76afd3?w=600&auto=format&fit=crop&q=80,https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop&q=80" | split: "," -%}
         {%- assign sb_index = i | minus: 1 | modulo: 4 -%}
         {%- assign sb_img = sidebar_products[sb_index] -%}
         {%- assign sb_titles = "Minimalist Watch,Running Sneakers,Leather Bag,Wireless Headphones" | split: "," -%}
         {%- assign sb_prices = "$0.60,$0.80,$1.00,$1.21" | split: "," -%}
         {%- assign sb_compares = "$0.92,$1.13,$1.33,$1.53" | split: "," -%}
         {%- assign sb_title = sb_titles[sb_index] -%}
         {%- assign sb_price = sb_prices[sb_index] -%}
         {%- assign sb_compare = sb_compares[sb_index] -%}

        <li>
          <div class="products dt-best-seller wow fadeIn animated" style="visibility: visible;">
            <div class="product-container">
              <a href="#" class="grid-link"> 
                {% if forloop.index == 3 %}
                <span class="badge badge--sale"> <span class="gift-tag badge__text">Sale</span> </span>
                {% endif %}

                <div class="reveal" style="aspect-ratio: 1 / 1; width: 100%; overflow: hidden;"> 
                  <img src="{{ sb_img }}" alt="{{ sb_title }}" style="width:100%;height:100%;aspect-ratio:1/1;object-fit:cover;" />
                </div>
              </a>
            </div>
           
            <div class="product-detail"> 
              <a href="#" class="grid-link__title">{{ sb_title }}</a>
              <div class="grid-link__meta">
                <div class="product_price"><span class="money">{{ sb_price }}</span></div>
                <del class="grid-link__sale_price"><span class="money">{{ sb_compare }}</span></del>
              </div>
            </div>
          </div>
        </li>
        {% endfor %} 
         {% endfor %}
      </ul> 
     {% comment %}
       <div class="top_products_nav"></div>
      {% endcomment %}
    </div>
</div>
 {% endif %} 

 {% schema %}
  {
    "name": "Home Sidebar Bestsellers",    
    "settings": [	
      {
        "type": "checkbox",
        "id": "show_best_products",
        "label": "Enable best sellers"
      },
{
"type": "color",
"id": "sidebar_bg_color",
"label": "Bg Color",
"default": "#fff"
},
	 {
        "type": "text",
        "id": "title",
        "label": "Heading"
      },
      {
        "type": "collection",
        "id": "bestseller",
        "label": "Collection"
      },
      {
        "type": "text",
        "id": "limit",
        "label": "Product Limit",
        "default": "4"
      }
	
]
  }
{% endschema %}

{% comment %}

<script type="text/javascript">
$(document).ready(function(){
     $(".home-sidebar-bestsellers .top-products").owlCarousel({ 
        loop:false,      
        nav:true,       
        dots: false,
        navContainer: ".home-sidebar-bestsellers .top_products_nav",
        navText: ['<a class="next btn"><i class="fa fa-chevron-left"></i></a>','<a class="prev btn active"><i class="fa fa-chevron-right"></i></a>'],
        responsive:{
            0:{
                items:1
            },
            600:{
                items:1
            },
            1000:{
                items:1
            }
        }
 
  });
});
      
</script>

{% endcomment %}


