{% if section.settings.display_top_bar %}    

<div class="top_bar top-bar-type-10">    
  <div class="container">
    {% if section.settings.header_phone_value != blank or  section.settings.header_mail_value != blank %}
    <ul class="top_bar_left">
      {% if section.settings.header_phone_value != blank %}
      <li><i class="fa fa-phone"></i> {{ section.settings.header_phone_value }}</li>
      {% endif %}
      {% if section.settings.header_mail_value != blank %}
      <li><i class="fa fa-envelope"></i> <a href="mailto:{{ section.settings.header_mail_value }}"> {{ section.settings.header_mail_value }}</a></li>
      {% endif %}
    </ul>
    {% endif %}


    <div class="customer_account">  
      {% if settings.display_currency %}   
      <div class="header_currency">
        <ul class="tbl-list">                    
          <li class="currency dropdown-parent uppercase currency-block">
            {% include 'currencies-switcher' %}
          </li>
        </ul>
      </div>        
      {% endif %}
    </div>    

  </div>
  
  <style>
     /* Top block */
    .header-type-10 .top_bar { background: {{ section.settings.top_bar_bg }}; }
    .header-type-10 .top_bar li { color:{{section.settings.top_bar_text}};}     
    .header-type-10 .top_bar a,.header-type-10 .top_bar button { color:{{section.settings.top_bar_links }};}    
    .header-type-10 .top_bar a:hover, .header-type-10 .top_bar a:hover span,.header-type-10 .top_bar button:hover,.header-type-10 li.init.dt-sc-toggle:hover  { color:{{section.settings.top_bar_link_hover }};}    

      /* Currency block */

     .header-type-10 .header_currency ul select {color:{{section.settings.currency_icon}};}   
    .header-type-10 .header_currency ul select:hover {color:{{section.settings.currency_icon_hover}};}  
    .header-type-10 .header_currency ul li.currency:hover:after {border-top-color:{{section.settings.currency_icon_hover}};}
    .header-type-10 .header_currency ul li.currency:after,.header-type-10 li.init.dt-sc-toggle:after {color:{{section.settings.currency_icon}};}
    .header-type-10 .header_currency option {background:{{section.settings.currency_bg}};color:{{section.settings.currency_link}};}
  </style>
  
</div> 
{% endif %}
{% schema %}
{
"name": "Top Bar",
"settings": [
{
"type":"checkbox",
"id": "display_top_bar",
"label": "Display topbar"	
},

{
"type": "text",
"id": "header_phone_value",
"label": "Phone number",
"default": "(00) 000 111 222"
},    
{
"type": "text",
"id": "header_mail_value",
"label": "Mail address",
"default": "info@somedomain.com"
},  

{
"type": "color",
"id": "top_bar_bg",
"label": "Top bar background",
"default": "#fff"
},
{
"type": "color",
"id": "top_bar_text",
"label": "Top bar text",
"default": "#000"
},
{
"type": "color",
"id": "top_bar_links",
"label": "Top bar links",
"default": "#000"
},
{
"type": "color",
"id": "top_bar_link_hover",
"label": "Top bar links hover",
"default": "#35b8f4"
},
{
"type": "header",
"content": "Border Block"
},
{
"type": "color",
"id": "top_border_between_bars",
"label": "Border lines",
"default": "#e4e4e4"
},
{
"type": "header",
"content": "Currency Block"
},

{
"type": "color",
"id": "currency_icon",
"label": "Current Text Color",
"default": "#fff"
},
{
"type": "color",
"id": "currency_icon_hover",
"label": "Text hover",
"default": "#35b8f4"
},
{
"type": "color",
"id": "currency_bg",
"label": "Current Background",
"default": "#fff"
},
{
"type": "color",
"id": "currency_link",
"label": "Currency Links",
"default": "#000"
}
]
}
{% endschema %}