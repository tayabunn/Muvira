    @font-face { font-family: 'montserratregular'; src: url('{{ 'montserrat-regular-webfont.woff2' | asset_url }}') format('woff2'), url('{{ 'montserrat-regular-webfont.woff' | asset_url }}') format('woff'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'montserratbold'; src: url('{{ 'montserrat-bold-webfont.woff2' | asset_url }}') format('woff2'), url('{{ 'montserrat-bold-webfont.woff' | asset_url }}') format('woff'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'montserratsemi_bold'; src: url('{{ 'montserrat-semibold-webfont.woff2' | asset_url }}') format('woff2'), url('{{ 'montserrat-semibold-webfont.woff' | asset_url }}') format('woff'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'montserratlight'; src: url('{{ 'montserrat-light-webfont.woff2' | asset_url }}') format('woff2'), url('{{ 'montserrat-light-webfont.woff' | asset_url }}') format('woff'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'montserratblack'; src: url('{{ 'montserrat-black-webfont.woff2' | asset_url }}') format('woff2'), url('{{ 'montserrat-black-webfont.woff' | asset_url }}') format('woff'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'FontAwesome'; src: url('{{ 'fontawesome-webfont.eot' | asset_url }}'); src: url('{{ 'fontawesome-webfont.eot' | asset_url }}?#iefix') format('embedded-opentype'), url('{{ 'fontawesome-webfont.woff2' | asset_url }}') format('woff2'), url('{{ 'fontawesome-webfont.woff' | asset_url }}') format('woff'), url('{{ 'fontawesome-webfont.ttf' | asset_url }}') format('truetype'), url('{{ 'fontawesome-webfont.svg' | asset_url }}#fontawesomeregular') format('svg'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'Material-Design-Iconic-Font'; src: url('{{ 'Material-Design-Iconic-Font.woff2' | asset_url }}') format('woff2'), url('{{ 'Material-Design-Iconic-Font.woff' | asset_url }}') format('woff'), url('{{ 'Material-Design-Iconic-Font.ttf' | asset_url }}') format('truetype'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'simple-line-icons'; src: url('{{ 'Simple-Line-Icons.eot' | asset_url }}'); src: url('{{ 'Simple-Line-Icons.eot' | asset_url }}?#iefix') format('embedded-opentype'), url('{{ 'Simple-Line-Icons.woff2' | asset_url }}') format('woff2'), url('{{ 'Simple-Line-Icons.woff' | asset_url }}') format('woff'), url('{{ 'Simple-Line-Icons.ttf' | asset_url }}') format('truetype'), url('{{ 'Simple-Line-Icons.svg' | asset_url }}#simple-line-icons') format('svg'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'icons'; src: url('{{ 'icons.eot' | asset_url }}'); src: url('{{ 'icons.eot' | asset_url }}?#iefix') format('embedded-opentype'), url('{{ 'icons.woff' | asset_url }}') format('woff'), url('{{ 'icons.ttf' | asset_url }}') format('truetype'), url('{{ 'icons.svg' | asset_url }}#timber-icons') format('svg'); font-weight: normal; font-style: normal; }
    
    /* Absolute pure white background for page containers */
    html, body, .wrapper-container, #PageContainer, .main-content, 
    .container-bg, .grid-uniform, .site-header, .header-type-10, 
    .sticky-animate, .homepage_sidebar, .widget, .main-slideshow, 
    .home-product-grid-type-12-b, .category-section, .support-block-type-4,
    .collection-products, .products-grid-view {
      background-color: #ffffff !important;
      background-image: none !important;
    }

    /* 1. Decreased height of Top Bar (Blue marked section) */
    .header-type-10 .top_bar, .top_bar, .top-bar-type-10 {
      padding: 3px 15px !important;
      min-height: auto !important;
    }
    .header-type-10 .top_bar ul li, .top_bar ul li {
      line-height: 20px !important;
    }

    /* 2. Increased height of Main Header (Green marked section) */
    .header-type-10 .site-header__menubar, .site-header__menubar {
      padding-top: 22px !important;
      padding-bottom: 22px !important;
    }

    /* 3. Set area under Red Navigation Bar to Pure White (#ffffff) */
    .header-type-10, .site-header, .header-sticky, #header-landing, .sticky-animate,
    .sticky-wrapper, #header-landing-sticky-wrapper, .is-sticky,
    .desktop-megamenu, .nav-bar-mobile, .breadcrumb, .breadcrumb_wrap, #breadcrumb {
      background-color: #ffffff !important;
      background-image: none !important;
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
      border: none !important;
      box-shadow: none !important;
    }

    /* Red Navigation Bar & White Menu Links */
    .menubar-section, .nav-bar, .desktop-megamenu, .mobile-nav-section, .site-nav-dropdown_inner {
      background-color: #e50914 !important;
      text-align: center !important;
    }
    .menu-tool {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      width: 100% !important;
    }
    .menu-tool ul.site-nav {
      display: inline-flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 20px !important;
      margin: 0 auto !important;
      padding: 6px 0 !important;
      list-style: none !important;
      float: none !important;
    }
    .menu-tool ul.site-nav > li {
      display: inline-flex !important;
      align-items: center !important;
      float: none !important;
    }
    .menu-tool ul.site-nav > li > a {
      color: #ffffff !important;
      font-weight: 600 !important;
      font-size: 14px !important;
      padding: 8px 16px !important;
      display: inline-flex !important;
      align-items: center !important;
      line-height: 1 !important;
      border-radius: 4px;
      transition: all 0.3s ease;
    }
    .menu-tool ul.site-nav > li > a:hover {
      color: #000000 !important;
      background-color: rgba(255, 255, 255, 0.2);
    }
    .menu-tool ul.site-nav > li.nav-account-item > a {
      padding: 8px 16px !important;
    }
