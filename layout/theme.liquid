<head>

  <!-- Basic page needs ================================================== -->
  <meta charset="utf-8">
  <!--[if IE]><meta http-equiv='X-UA-Compatible' content='IE=edge,chrome=1'><![endif]-->

  <link rel="shortcut icon" href="{{ 'logo.png' | asset_url }}" type="image/png" />
  <link rel="apple-touch-icon" href="{{ 'logo.png' | asset_url }}" />

  <!-- Title and description ================================================== -->
  <title>
    {{ page_title }}{% if current_tags %}{% assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>
  {% if page_description %}
  <meta name="description" content="{{ page_description | escape }}">
  {% endif %}
  <!-- Social meta ================================================== -->
  {% include 'social-meta-tags' %}
  <!-- Helpers ================================================== -->
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_primary }}">

  <!-- CSS ================================================== -->
  {{ 'timber.scss.css' | asset_url | stylesheet_tag }}
  {{ 'fonts.min.css' | asset_url | stylesheet_tag }}  
  {{ 'style.css' | asset_url | stylesheet_tag }}   
  {{ 'settings.css' | asset_url | stylesheet_tag }}  
  {{ 'owl-carousel.css' | asset_url | stylesheet_tag }}  
  {{ 'slick.scss.css' | asset_url | stylesheet_tag }}
  {{ 'slick-theme.css' | asset_url | stylesheet_tag }}
  {{ 'flex-slider.css' | asset_url | stylesheet_tag }}
  {{ 'magnific-popup.css' | asset_url | stylesheet_tag }}

  <!-- Font-face declarations injected directly to guarantee loading -->
  <style>
    @font-face { font-family: 'montserratregular'; src: url('{{ 'montserrat-regular-webfont.woff2' | asset_url }}') format('woff2'), url('{{ 'montserrat-regular-webfont.woff' | asset_url }}') format('woff'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'montserratbold'; src: url('{{ 'montserrat-bold-webfont.woff2' | asset_url }}') format('woff2'), url('{{ 'montserrat-bold-webfont.woff' | asset_url }}') format('woff'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'montserratsemi_bold'; src: url('{{ 'montserrat-semibold-webfont.woff2' | asset_url }}') format('woff2'), url('{{ 'montserrat-semibold-webfont.woff' | asset_url }}') format('woff'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'montserratlight'; src: url('{{ 'montserrat-light-webfont.woff2' | asset_url }}') format('woff2'), url('{{ 'montserrat-light-webfont.woff' | asset_url }}') format('woff'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'montserratblack'; src: url('{{ 'montserrat-black-webfont.woff2' | asset_url }}') format('woff2'), url('{{ 'montserrat-black-webfont.woff' | asset_url }}') format('woff'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'FontAwesome'; src: url('{{ 'fontawesome-webfont.eot' | asset_url }}'); src: url('{{ 'fontawesome-webfont.eot' | asset_url }}?#iefix') format('embedded-opentype'), url('{{ 'fontawesome-webfont.woff2' | asset_url }}') format('woff2'), url('{{ 'fontawesome-webfont.woff' | asset_url }}') format('woff'), url('{{ 'fontawesome-webfont.ttf' | asset_url }}') format('truetype'), url('{{ 'fontawesome-webfont.svg' | asset_url }}#fontawesomeregular') format('svg'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'Material-Design-Iconic-Font'; src: url('{{ 'Material-Design-Iconic-Font.woff2' | asset_url }}') format('woff2'), url('{{ 'Material-Design-Iconic-Font.woff' | asset_url }}') format('woff'), url('{{ 'Material-Design-Iconic-Font.ttf' | asset_url }}') format('truetype'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'simple-line-icons'; src: url('{{ 'Simple-Line-Icons.eot' | asset_url }}'); src: url('{{ 'Simple-Line-Icons.eot' | asset_url }}?#iefix') format('embedded-opentype'), url('{{ 'Simple-Line-Icons.woff2' | asset_url }}') format('woff2'), url('{{ 'Simple-Line-Icons.woff' | asset_url }}') format('woff'), url('{{ 'Simple-Line-Icons.ttf' | asset_url }}') format('truetype'), url('{{ 'Simple-Line-Icons.svg' | asset_url }}#simple-line-icons') format('svg'); font-weight: normal; font-style: normal; }
    @font-face { font-family: 'icons'; src: url('{{ 'icons.eot' | asset_url }}'); src: url('{{ 'icons.eot' | asset_url }}?#iefix') format('embedded-opentype'), url('{{ 'icons.woff' | asset_url }}') format('woff'), url('{{ 'icons.ttf' | asset_url }}') format('truetype'), url('{{ 'icons.svg' | asset_url }}#timber-icons') format('svg'); font-weight: normal; font-style: normal; }
    
    /* Absolute pure white background for page containers */
    html, body, .wrapper-container, #PageContainer, .main-content, 
    .container-bg, .grid-uniform, .site-header, .header-type-10, 
    .sticky-animate, .homepage_sidebar, .widget, .main-slideshow, 
    .home-product-grid-type-12-b, .category-section, .support-block-type-4,
    .collection-products, .products-grid-view {
      background-color: #ffffff !important;
      background-image: none !important;
    }

    /* 1. Decreased height of Top Bar (Blue marked section) */
    .header-type-10 .top_bar, .top_bar, .top-bar-type-10 {
      padding: 3px 15px !important;
      min-height: auto !important;
    }
    .header-type-10 .top_bar ul li, .top_bar ul li {
      line-height: 20px !important;
    }

    /* 2. Increased height of Main Header (Green marked section) */
    .header-type-10 .site-header__menubar, .site-header__menubar {
      padding-top: 22px !important;
      padding-bottom: 22px !important;
    }

    /* 4. Top Right Header Account Buttons (Sign In & Register) */
    .menu_bar_right {
      display: flex !important;
      align-items: center !important;
      justify-content: flex-end !important;
      gap: 15px !important;
      float: right !important;
    }
    .header-account-btn-wrap {
      display: inline-flex !important;
      align-items: center !important;
      gap: 10px !important;
      margin-left: 15px !important;
      float: none !important;
    }
    .header-btn-signin {
      background-color: #ffffff !important;
      color: #e50914 !important;
      border: 1.5px solid #e50914 !important;
      padding: 8px 18px !important;
      border-radius: 4px !important;
      font-weight: 600 !important;
      font-size: 13px !important;
      display: inline-flex !important;
      align-items: center !important;
      gap: 6px !important;
      text-decoration: none !important;
      transition: all 0.3s ease !important;
      line-height: 1 !important;
    }
    .header-btn-signin:hover {
      background-color: #e50914 !important;
      color: #ffffff !important;
      border-color: #e50914 !important;
    }
    .header-btn-register {
      background-color: #e50914 !important;
      color: #ffffff !important;
      border: 1.5px solid #e50914 !important;
      padding: 8px 18px !important;
      border-radius: 4px !important;
      font-weight: 600 !important;
      font-size: 13px !important;
      display: inline-flex !important;
      align-items: center !important;
      gap: 6px !important;
      text-decoration: none !important;
      transition: all 0.3s ease !important;
      line-height: 1 !important;
    }
    .header-btn-register:hover {
      background-color: #c00712 !important;
      color: #ffffff !important;
      border-color: #c00712 !important;
    /* 5. Sticky Navbar Clean Scroll Rule: Remove Cart, Badge, Sign In, and Register from Sticky Navbar */
    .is-sticky .menu_bar_right,
    .is-sticky .header_cart,
    .is-sticky .header-account-btn-wrap,
    .is-sticky .cart,
    .header-type-10 .is-sticky .menu_bar_right {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    /* 6. Universal 1:1 Square Product Image Container & Fit Rules (General) */
    .main-content .products .product-container .reveal,
    .main-content .products .product-container .grid-link,
    .main-content .products .reveal,
    .main-content .grid-link .reveal {
      aspect-ratio: 1 / 1 !important;
      width: 100% !important;
      overflow: hidden !important;
      display: block !important;
    }
    .main-content .products .featured-image,
    .main-content .products .reveal img,
    .main-content .products .product-container img,
    .main-content .products img.hidden-feature_img {
      aspect-ratio: 1 / 1 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center !important;
      display: block !important;
    }

    /* 7. SCOPED CATEGORIES SIDEBAR ALIGNMENT (.homepage_sidebar ONLY) */
    .homepage_sidebar_column,
    .homepage_sidebar {
      width: 100% !important;
      padding-left: 0 !important;
      margin-left: 0 !important;
      box-sizing: border-box !important;
    }
    .homepage_sidebar .widget {
      float: none !important;
      width: 100% !important;
      padding-left: 0 !important;
      padding-right: 10px !important;
      padding-top: 15px !important;
      padding-bottom: 15px !important;
      margin-left: 0 !important;
      margin-bottom: 24px !important;
      box-sizing: border-box !important;
      background-color: #ffffff !important;
    }
    /* Eliminate huge gap between Category widget and Product list widget & force 0px left padding */
    .homepage_sidebar .widget.widget_product_categories {
      margin-bottom: 0 !important;
      padding-bottom: 10px !important;
      padding-left: 0 !important;
      margin-left: 0 !important;
    }
    .homepage_sidebar .widget.widget_top_rated_products,
    .homepage_sidebar .home-sidebar-bestsellers .widget {
      margin-top: 0 !important;
      padding-top: 10px !important;
      padding-left: 0 !important;
      margin-left: 0 !important;
    }

    /* Heading "CATEGORIES" & Red Underline */
    .homepage_sidebar .widget h4 {
      margin: 0 0 16px 0 !important;
      padding: 0 !important;
      float: none !important;
      width: 100% !important;
      text-align: left !important;
    }
    .homepage_sidebar .widget h4 span {
      display: block !important;
      width: 100% !important;
      padding: 0 0 12px 0 !important;
      margin: 0 !important;
      float: none !important;
      border-bottom: 2px solid #e50914 !important;
      font-size: 16px !important;
      font-weight: 700 !important;
      text-transform: uppercase !important;
      letter-spacing: 0.5px !important;
      color: #000000 !important;
      box-sizing: border-box !important;
      text-align: left !important;
    }

    /* Category Links (Home, Catalog, Contact) & (0) counts */
    .homepage_sidebar ul.product-categories,
    .homepage_sidebar ul.dt-sc-toggle-frame-set {
      list-style: none !important;
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
    }
    .homepage_sidebar ul.product-categories li.cat-item {
      float: none !important;
      width: 100% !important;
      margin: 0 0 14px 0 !important;
      padding: 0 !important;
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
    }
    .homepage_sidebar ul.product-categories li.cat-item:last-child {
      margin-bottom: 0 !important;
    }
    .homepage_sidebar ul.product-categories li.cat-item i {
      display: none !important;
    }
    .homepage_sidebar ul.product-categories li.cat-item a {
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      width: 100% !important;
      font-size: 14px !important;
      font-weight: 600 !important;
      color: #333333 !important;
      text-decoration: none !important;
      margin: 0 !important;
      padding: 0 !important;
      text-align: left !important;
    }
    .homepage_sidebar ul.product-categories li.cat-item a span {
      float: none !important;
      margin-left: auto !important;
      color: #666666 !important;
      font-weight: 400 !important;
    }

    /* Product List Layout inside Sidebar (Text on Left, Image on Right) */
    .homepage_sidebar ul.no-bullets.top-products,
    .homepage_sidebar ul.top-products {
      list-style: none !important;
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
    }
    .homepage_sidebar .home-sidebar-bestsellers .top-products li,
    .homepage_sidebar .top-products li {
      float: none !important;
      width: 100% !important;
      margin-bottom: 20px !important;
      padding: 0 !important;
    }
    .homepage_sidebar .products.dt-best-seller,
    .homepage_sidebar .products {
      display: flex !important;
      flex-direction: row-reverse !important;
      justify-content: space-between !important;
      align-items: center !important;
      gap: 15px !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      box-sizing: border-box !important;
    }

    .homepage_sidebar .top_product_count,
    .homepage_sidebar span.top_product_count {
      display: none !important;
      width: 0 !important;
      height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      flex: 0 0 0px !important;
    }

    /* Text Detail Container - EXACT FLUSH LEFT ALIGNMENT MATCHING CATEGORIES */
    .homepage_sidebar .products .product-detail,
    .homepage_sidebar .home-sidebar-bestsellers .top-products-detail {
      flex: 1 1 auto !important;
      width: auto !important;
      float: none !important;
      text-align: left !important;
      margin: 0 !important;
      padding: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: flex-start !important;
    }
    .homepage_sidebar .products .grid-link__title {
      font-size: 14px !important;
      font-weight: 700 !important;
      color: #000000 !important;
      text-decoration: none !important;
      margin: 0 0 4px 0 !important;
      padding: 0 !important;
      line-height: 1.3 !important;
      display: block !important;
      text-align: left !important;
    }
    .homepage_sidebar .products .grid-link__meta {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      justify-content: center !important;
      margin: 0 !important;
      padding: 0 !important;
      text-align: left !important;
    }
    .homepage_sidebar .products .product_price,
    .homepage_sidebar .products .grid-link__org_price {
      font-size: 14px !important;
      font-weight: 700 !important;
      color: #000000 !important;
      margin: 0 !important;
      padding: 0 !important;
      text-align: left !important;
      display: block !important;
    }
    .homepage_sidebar .products del.grid-link__sale_price,
    .homepage_sidebar .products del {
      font-size: 12px !important;
      color: #888888 !important;
      margin-top: 2px !important;
      padding: 0 !important;
      text-align: left !important;
      display: block !important;
    }

    /* Image Container - Slightly Wider 95px Square Image */
    .homepage_sidebar .products .product-container,
    .homepage_sidebar .home-sidebar-bestsellers .thumb {
      flex: 0 0 95px !important;
      width: 95px !important;
      height: 95px !important;
      aspect-ratio: 1 / 1 !important;
      float: none !important;
      margin: 0 !important;
      padding: 0 !important;
      position: relative !important;
      overflow: hidden !important;
      border-radius: 4px !important;
    }
    .homepage_sidebar .products .product-container .reveal,
    .homepage_sidebar .products .product-container a.grid-link {
      width: 100% !important;
      height: 100% !important;
      aspect-ratio: 1 / 1 !important;
      display: block !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    .homepage_sidebar .products .product-container img,
    .homepage_sidebar .products .reveal img,
    .homepage_sidebar .home-sidebar-bestsellers .thumb img {
      width: 100% !important;
      height: 100% !important;
      aspect-ratio: 1 / 1 !important;
      object-fit: cover !important;
      object-position: center !important;
      display: block !important;
    }
    .homepage_sidebar .products .badge--sale {
      position: absolute !important;
      top: 4px !important;
      left: 4px !important;
      z-index: 5 !important;
      background-color: #e50914 !important;
      color: #ffffff !important;
      font-size: 9px !important;
      font-weight: 700 !important;
      padding: 2px 5px !important;
      border-radius: 2px !important;
      text-transform: uppercase !important;
      line-height: 1 !important;
    }
    .homepage_sidebar .products .ImageWrapper,
    .homepage_sidebar .products .product-button {
      display: none !important;
    }

    /* 3. Completely remove black gap & space under Red Navigation Bar */
    .header-type-10, .site-header, .header-sticky, #header-landing, .sticky-animate,
    .sticky-wrapper, #header-landing-sticky-wrapper, .is-sticky,
    .desktop-megamenu, .nav-bar-mobile, .breadcrumb, .breadcrumb_wrap, #breadcrumb {
      background-color: #ffffff !important;
      background-image: none !important;
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
      border: none !important;
      box-shadow: none !important;
    }
    .main-content {
      margin-top: 0 !important;
      padding-top: 0 !important;
    }
    .dt-sc-hr-invisible-small, .dt-sc-hr-invisible-large, .dt-sc-hr-invisible, .dt-sc-hr-invisible-medium {
      display: none !important;
      margin: 0 !important;
      padding: 0 !important;
      height: 0 !important;
    }

    /* Red Navigation Bar & White Menu Links */
    .menubar-section, .nav-bar, .desktop-megamenu, .mobile-nav-section, .site-nav-dropdown_inner {
      background-color: #e50914 !important;
      text-align: center !important;
    }
    .menu-tool {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      width: 100% !important;
    }
    .menu-tool ul.site-nav {
      display: inline-flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 20px !important;
      margin: 0 auto !important;
      padding: 6px 0 !important;
      list-style: none !important;
      float: none !important;
    }
    .menu-tool ul.site-nav > li {
      display: inline-flex !important;
      align-items: center !important;
      float: none !important;
    }
    .menu-tool ul.site-nav > li > a {
      color: #ffffff !important;
      font-weight: 600 !important;
      font-size: 14px !important;
      padding: 8px 16px !important;
      display: inline-flex !important;
      align-items: center !important;
      line-height: 1 !important;
      border-radius: 4px;
      transition: all 0.3s ease;
    }
    .menu-tool ul.site-nav > li > a:hover {
      color: #000000 !important;
      background-color: rgba(255, 255, 255, 0.2);
    }
    .menu-tool ul.site-nav > li.nav-account-item > a {
      padding: 8px 16px !important;
    }
  </style>

  {% if settings.base_font contains 'Google' %}
  <link rel="stylesheet" type="text/css" href="//fonts.googleapis.com/css?family={{ settings.base_font | remove: 'Google+' }}:300,300italic,400,600,400italic,600italic,700,700italic,800,800italic">
